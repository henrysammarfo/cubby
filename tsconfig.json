{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "src/**/*.ts",
    "web/passkey.ts",
    "web/wizard.ts",
    "web/hold.ts",
    ".next/types/**/*.ts",
    "css.d.ts",
    "docs/proofs/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "web/dist",
    "scripts",
    "test"
  ]
}
